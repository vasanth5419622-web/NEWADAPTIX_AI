# ==========================================
# ADAPTIX-FARM Environment Configuration
# ==========================================

APP_ENV=development
PORT=8000
HOST=127.0.0.1
DEBUG=true

# Database
DATABASE_URL=sqlite:///./data/adaptix_farm.db

# ------------------------------------------
# Model 1: Open-weight / Smaller Model
# Roles: First-pass image analysis, Crop ID, Fast classification
# ------------------------------------------
OPEN_MODEL_PROVIDER=mock
OPEN_MODEL_NAME=qwen-vl-small
OPEN_MODEL_API_KEY=
OPEN_MODEL_BASE_URL=

# ------------------------------------------
# Model 2: Commercial / Proprietary Model A
# Roles: Complex multimodal reasoning, Ambiguous symptoms, Escalation
# ------------------------------------------
COMMERCIAL_MODEL_A_PROVIDER=mock
COMMERCIAL_MODEL_A_NAME=gpt-4o-mini
COMMERCIAL_MODEL_A_API_KEY=
COMMERCIAL_MODEL_A_BASE_URL=

# ------------------------------------------
# Model 3: Commercial / Proprietary Model B
# Roles: Independent verification, Critic, Evidence consistency
# ------------------------------------------
COMMERCIAL_MODEL_B_PROVIDER=mock
COMMERCIAL_MODEL_B_NAME=claude-3-5-sonnet
COMMERCIAL_MODEL_B_API_KEY=
COMMERCIAL_MODEL_B_BASE_URL=

# ------------------------------------------
# RAG & Embeddings
# ------------------------------------------
EMBEDDING_PROVIDER=local_semantic
VECTOR_DB_URL=./data/vectorstore

# ------------------------------------------
# Voice Speech-to-Text & Text-to-Speech
# ------------------------------------------
STT_PROVIDER=browser_whisper
STT_API_KEY=

TTS_PROVIDER=browser_speech
TTS_API_KEY=

# Cloud Fallbacks (Optional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
